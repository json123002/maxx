[Unit]
Description=Turnover Screener API (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/turnover-screener/backend
Environment=TZ=Asia/Shanghai
# 初始管理员密码（仅首次建库生效），上线后请立即在页面「修改密码」改掉
Environment=TS_ADMIN_PASSWORD=admin123
# 抓数间隔（分钟）
Environment=TS_FETCH_INTERVAL_MIN=3
ExecStart=/opt/turnover-screener/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# 内存保护：异常泄漏时自动重启而不是拖垮整机
MemoryMax=700M

[Install]
WantedBy=multi-user.target
