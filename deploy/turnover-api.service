[Unit]
Description=Turnover Screener API (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=maxx
WorkingDirectory=/home/maxx/turnover-screener/backend
Environment=TZ=Asia/Shanghai
# 敏感配置(隐藏 root 密码 TS_ROOT_PASSWORD 等)由该文件注入,文件不进 git,
# 由 deploy.py 部署时按本机环境变量写入(权限 600);不存在时忽略(-前缀)
EnvironmentFile=-/etc/turnover-screener.env
# 初始管理员密码（仅首次建库生效），上线后请立即在页面「修改密码」改掉
# Set TS_ADMIN_PASSWORD in /etc/turnover-screener.env for first-time setup.
# 抓数间隔（分钟）
Environment=TS_FETCH_INTERVAL_MIN=3
ExecStart=/home/maxx/turnover-screener/backend/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# 内存保护：异常泄漏时自动重启而不是拖垮整机
MemoryMax=700M

[Install]
WantedBy=multi-user.target
